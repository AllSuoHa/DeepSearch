# 复制为 .env 后填写；示例文件只能保留占位符。
# online 为默认运行方式；只有显式设置 mock 才使用离线演示数据。
DEEPSEARCH_RUNTIME_MODE=online

# 研究模型：OpenAI Chat Completions 兼容接口。在线研究必须配置。
DEEPSEARCH_API_KEY=
DEEPSEARCH_BASE_URL=https://api.openai.com/v1
DEEPSEARCH_MODEL=gpt-4o-mini
DEEPSEARCH_LLM_TIMEOUT=180

# 可选：快速回答模型；也可在设置页显式选择复用研究模型连接。
DEEPSEARCH_CHAT_API_KEY=
DEEPSEARCH_CHAT_BASE_URL=
DEEPSEARCH_CHAT_MODEL=
DEEPSEARCH_CHAT_TIMEOUT=30

# 可选正式搜索 API；密钥只允许放在环境变量或 Streamlit Secrets。
DEEPSEARCH_BRAVE_API_KEY=
DEEPSEARCH_TAVILY_API_KEY=

# 可选自托管搜索接口；实例必须启用 JSON 输出。
DEEPSEARCH_SEARXNG_BASE_URL=

# 可选：把手动推送或显式启用自动投递的资产写入 CustomerService。
DEEPSEARCH_CUSTOMER_SERVICE_ENABLED=false
DEEPSEARCH_CUSTOMER_SERVICE_URL=http://127.0.0.1:8000
DEEPSEARCH_CUSTOMER_SERVICE_INTEGRATION_KEY=
# CustomerService 开启全局 API_ACCESS_KEY 时同时配置。
DEEPSEARCH_CUSTOMER_SERVICE_API_KEY=
