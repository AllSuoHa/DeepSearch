# 可选：OpenAI 兼容接口。不配置时自动使用 Mock LLM。
DEEPSEARCH_API_KEY=
DEEPSEARCH_BASE_URL=https://api.openai.com/v1
DEEPSEARCH_MODEL=gpt-4o-mini
DEEPSEARCH_MODE=auto

# 可选：把显式勾选的自主任务报告自动写入 CustomerService 知识库。
DEEPSEARCH_CUSTOMER_SERVICE_ENABLED=false
DEEPSEARCH_CUSTOMER_SERVICE_URL=http://127.0.0.1:8000
DEEPSEARCH_CUSTOMER_SERVICE_INTEGRATION_KEY=
# CustomerService 开启全局 API_ACCESS_KEY 时同时配置。
DEEPSEARCH_CUSTOMER_SERVICE_API_KEY=
